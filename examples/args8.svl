module Args8;
allow Console;

struct Vector2 { x: i32; y: i32; }

fn sum8(a: i32, b: i32, c: i32, d: i32, e: i32, f: i32, g: i32, h: i32) -> i32 {
    return a + 2*b + 3*c + 4*d + 5*e + 6*f + 7*g + 8*h;
}
fn len2(v: Vector2) -> i32 {
    var w = v;
    w.x = 100;            // local copy: caller must not change
    return v.x * v.x + v.y * v.y + w.x - 100;
}

fn main() -> i32 {
    println(sum8(1, 1, 1, 1, 1, 1, 1, 1));         // 36
    println(1 + sum8(1, 2, 3, 4, 5, 6, 7, 8));      // 1 + 204 (nested, odd stack)
    var v: Vector2; v.x = 3; v.y = 4;
    println(len2(v));                               // 25
    println(v.x);                                   // 3
    return 0;
}
