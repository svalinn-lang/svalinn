module Features;
allow Console;
protect Process;

enum Direction { North, South, East, West }

struct Vector2 {
    x: i32;
    y: i32;
}

fn add(a: i32, b: i32) -> i32 { return a + b; }

fn fib(n: i32) -> i32 {
    if n < 2 { return n; }
    return fib(n - 1) + fib(n - 2);
}

fn bump(ref hp: i32) { hp += 10; }

fn describe(d: Direction) {
    match d {
        Direction.North => println("north"),
        Direction.South => println("south"),
        _ => println("sideways"),
    }
}

fn main() -> i32 {
    let score = 100;
    var health: i32 = 90;
    bump(ref health);
    println(health);
    println(add(score, 5));
    println(fib(20));

    var v: Vector2;
    v.x = 3; v.y = 4;
    println(v.x * v.x + v.y * v.y);

    var nums: [5]i32;
    for i in 0..5 { nums[i] = i * i; }
    var sum = 0;
    for n in nums { sum += n; }
    println(sum);

    describe(Direction.North);
    describe(Direction.West);

    var small: u8 = 250;
    small += 10;
    println(small);

    let big: i64 = 3000000000 * 2;
    println(big);
    println(true && !false);
    println('A');

    var k = 0;
    while true {
        k += 1;
        if k == 3 { continue; }
        if k > 5 { break; }
    }
    println(k);
    return 0;
}
