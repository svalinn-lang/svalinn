module Mandelbrot;
allow Console;

fn main() -> i32 {
    let n: i64 = 4000;
    var count: i64 = 0;
    for y in 0..n {
        let ci = 2.0 * (y as f64) / (n as f64) - 1.0;
        for x in 0..n {
            let cr = 2.0 * (x as f64) / (n as f64) - 1.5;
            var zr = 0.0;
            var zi = 0.0;
            var i = 0;
            var inside = true;
            while i < 50 {
                let tr = zr * zr - zi * zi + cr;
                let ti = 2.0 * zr * zi + ci;
                zr = tr;
                zi = ti;
                if zr * zr + zi * zi > 4.0 {
                    inside = false;
                    break;
                }
                i += 1;
            }
            if inside { count += 1; }
        }
    }
    println(count);
    return 0;
}
