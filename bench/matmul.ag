module MatMul;
allow Console;
allow Native;

extern fn printf(fmt: String, x: f64) -> i32;

var a: [250000]f64;
var b: [250000]f64;
var c: [250000]f64;

fn main() -> i32 {
    let n: i64 = 500;
    for i in 0..n {
        for j in 0..n {
            a[i * n + j] = ((i * 7 + j * 3) % 13) as f64 / 13.0;
            b[i * n + j] = ((i * 5 + j * 11) % 17) as f64 / 17.0;
        }
    }
    for rep in 0..3 {
        for i in 0..n * n { c[i] = 0.0; }
        for i in 0..n {
            for k in 0..n {
                let aik = a[i * n + k];
                for j in 0..n {
                    c[i * n + j] += aik * b[k * n + j];
                }
            }
        }
    }
    var sum = 0.0;
    for i in 0..n * n { sum += c[i]; }
    unsafe { printf("%.6f\n", sum); }
    return 0;
}
