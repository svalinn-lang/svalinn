module Classes;
allow Console;

enum IOError { NotFound, Denied }

class Player {
    private:
        let name: String;
        var hp: i32 = 100;
        var score: i64;

    public:
        ctor(name: String) {
            this.name = name;
        }

        fn damage(amount: i32) {
            this.hp -= amount;
            if this.hp < 0 { this.hp = 0; }
        }
        fn heal(amount: i32) { this.hp += amount; }
        fn health() -> i32 { return this.hp; }
        fn getName() -> String { return this.name; }
        fn isDead() -> bool { return this.hp == 0; }
        fn addScore(n: i64) { this.score += n; }
        fn getScore() -> i64 { return this.score; }

        static fn maxHealth() -> i32 { return 100; }
}

class Counter {
    public:
        var n: i32 = 5;
        fn bump() { this.n += 1; }
}

class Vec2 {
    public:
        var x: i32;
        var y: i32;
        ctor(x: i32, y: i32) { this.x = x; this.y = y; }
        fn add(o: Vec2) -> Vec2 { return Vec2(this.x + o.x, this.y + o.y); }
        fn dot(o: Vec2) -> i32 { return this.x * o.x + this.y * o.y; }
}

fn divide(a: i32, b: i32) -> Result<i32, String> {
    if b == 0 { return Err("division by zero"); }
    return Ok(a / b);
}

fn load(ok: bool) -> Result<i64, IOError> {
    if ok { return Ok(42); }
    return Err(IOError.NotFound);
}

fn sum_two(a: i32, b: i32, c: i32) -> Result<i32, String> {
    let x = divide(a, b)?;
    let y = divide(x, c)?;
    return Ok(x + y);
}

fn check(v: i32) -> Result<void, String> {
    if v < 0 { return Err("negative"); }
    return Ok();
}

fn both(v: i32) -> Result<i32, String> {
    check(v)?;
    return Ok(v * 2);
}

fn show(r: Result<i32, String>) {
    match r {
        Ok(v) => { println(v); }
        Err(e) => { println(e); }
    }
}

fn main() -> i32 {
    let p = Player("Pilot");
    println(p.getName());
    println(p.health());
    p.damage(30);
    println(p.health());
    p.heal(5);
    p.addScore(1000000000000);
    println(p.getScore());
    println(p.isDead());
    p.damage(500);
    println(p.isDead());
    println(Player.maxHealth());

    let c = Counter();
    c.bump(); c.bump();
    println(c.n);

    let a = Vec2(1, 2);
    let b = Vec2(10, 20);
    let s = a.add(b);
    println(s.x); println(s.y);
    println(a.dot(b));
    println(Vec2(3, 4).dot(Vec2(1, 1)));

    show(divide(10, 2));
    show(divide(1, 0));
    show(sum_two(100, 5, 2));
    show(sum_two(100, 0, 2));
    show(sum_two(100, 5, 0));
    show(both(21));
    show(both(0 - 1));

    match load(true) {
        Ok(n) => { println(n); }
        Err(e) => { println("io error"); }
    }
    match load(false) {
        Ok(n) => { println(n); }
        Err(_) => { println("io error"); }
    }
    let r: Result<i32, String> = Ok(7);
    match r { Ok(v) => { println(v + 1); } _ => { println("other"); } }
    return 0;
}
