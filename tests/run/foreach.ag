module ForEach;
allow Console;
allow Native;
import std.vec;

struct P { x: i32; y: i32; }

class Bag {
    private:
        var a: [4]i64;
    public:
        ctor() { this.a[0] = 7; this.a[1] = 8; this.a[2] = 9; this.a[3] = 10; }
        fn len() -> i64 { return 3; }
        fn item(i: i64) -> i64 { return this.a[i] * 2; }
}

fn total(ref v: Vec<i64>) -> i64 {
    var s: i64 = 0;
    for x in v { s += x; }
    return s;
}

fn main() -> i32 {
    var v = Vec<i64>();
    for i in 0..6 { v.push((i * i) as i64); }
    for x in v { print(x); print(" "); }
    println("");
    println(total(ref v));
    for x in v {
        if x == 1 { continue; }
        if x == 16 { break; }
        println(x);
    }
    var ps = Vec<P>();
    for i in 0..3 { var p: P; p.x = i; p.y = i * 100; ps.push(p); }
    for p in ps { println(p.x + p.y); }
    let b = Bag();
    for x in b { println(x); }
    var e = Vec<i32>();
    for x in e { println(x); }
    println("done");
    return 0;
}
