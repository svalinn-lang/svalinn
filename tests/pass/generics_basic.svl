module G;
allow Console;
allow Native;

struct Pair<A, B> { first: A; second: B; }

class Box<T> {
    public:
        var value: T;
        ctor(v: T) { this.value = v; }
        fn get() -> T { return this.value; }
        fn set(v: T) { this.value = v; }
}

fn max<T>(a: T, b: T) -> T { if a > b { return a; } return b; }
fn swap<T>(ref a: T, ref b: T) { let t = a; a = b; b = t; }
fn firstOf<A, B>(p: Pair<A, B>) -> A { return p.first; }

fn main() -> i32 {
    println(max(3, 9));
    println(max<i64>(5, 2));
    println(max(10 as u8, 20 as u8));
    var x = 1; var y = 2;
    swap(ref x, ref y);
    println(x); println(y);
    let b = Box<i32>(41);
    b.set(b.get() + 1);
    println(b.get());
    let s = Box<String>("hi");
    println(s.get());
    var p: Pair<i32, i64>;
    p.first = 7; p.second = 8;
    println(firstOf(p));
    let bb = Box<Box<i32>>(Box<i32>(5));
    println(bb.get().get());
    return 0;
}
