// The Aegis compiler, written in Aegis. Same command line as the C compiler (src/aegisc.c):
//   aegisc <file.ag> [-o out] [-O] [-S] [--dump-ast] [--dump-sema] [--version]
module AegiscSelf;
allow Console;
allow Native;
allow File.Read;
allow File.Write;
allow Process.Spawn;

import std.sys;
import std.io;
import std.mem;
import lex;
import err;
import types;
import ast;
import parse;
import sema;
import dump;
import gen;
import opt;

unsafe fn main(argc: i32, argv: **u8) -> i32 {
    var input: *u8 = null;
    var outp: *u8 = "a.out" as *u8;
    var asm_only = false;
    var dump_a = false;
    var dump_s = false;
    var i = 1;
    while i < argc {
        let a = argv[i] as String;
        if strcmp(a as *u8, "-o" as *u8) == 0 && i + 1 < argc { i += 1; outp = argv[i]; }
        else if strcmp(a as *u8, "-S" as *u8) == 0 { asm_only = true; }
        else if strcmp(a as *u8, "--dump-ast" as *u8) == 0 { dump_a = true; }
        else if strcmp(a as *u8, "--dump-sema" as *u8) == 0 { dump_s = true; }
        else if strcmp(a as *u8, "-O" as *u8) == 0 { optlvl = 1; }
        else if strcmp(a as *u8, "--test" as *u8) == 0 { test_mode = 1; }
        else if strcmp(a as *u8, "--version" as *u8) == 0 { println("aegisc 1.0.0-rc.1 (self-hosted)"); return 0; }
        else if argv[i][0] == '-' { println("usage: aegisc <file.ag> [-o out] [-S] [-O] [--dump-ast] [--dump-sema]"); return 1; }
        else { input = argv[i]; }
        i += 1;
    }
    if input == null { println("usage: aegisc <file.ag> [-o out] [-S] [-O] [--dump-ast] [--dump-sema]"); return 1; }
    add_file_name(input);
    src_dir = dir_of(input);
    exe_dir = dir_of(argv[0]);
    var len: i32 = 0;
    let src = read_file(input as String, ref len);
    if src == null { printf("aegisc: cannot open '%s'\n", input as i64, 0, 0); return 1; }
    types_init();
    var cnt: i32 = 0;
    toks = lex_to_array(src, len, 0, ref cnt);
    ntoks = cnt;
    ctoks = cnt + 1;
    load_prelude();
    load_main_args();
    if test_mode != 0 { load_test_runner(); }
    expand_imports();
    prescan();
    parse_program();
    if dump_a { dump_typed = 0; dump_ast(); return 0; }
    sema();
    if dump_s { dump_typed = 1; dump_ast(); return 0; }
    var fp: [1200]u8;
    snprintf(&fp[0], 1200, "%s/lib/rt/fault.s", exe_dir as i64, 0, 0);
    if !file_exists(&fp[0]) { snprintf(&fp[0], 1200, "%s/../lib/rt/fault.s", exe_dir as i64, 0, 0); }
    if !file_exists(&fp[0]) { println("aegisc: cannot find the runtime (lib/rt/fault.s)"); return 1; }
    var flen: i32 = 0;
    rt_fault_text = read_file(&fp[0] as String, ref flen);
    if uses_async != 0 {
        var rp: [1200]u8;
        snprintf(&rp[0], 1200, "%s/lib/rt/async.s", exe_dir as i64, 0, 0);
        if !file_exists(&rp[0]) { snprintf(&rp[0], 1200, "%s/../lib/rt/async.s", exe_dir as i64, 0, 0); }
        if !file_exists(&rp[0]) { println("aegisc: cannot find the async runtime (lib/rt/async.s)"); return 1; }
        var rlen: i32 = 0;
        rt_async_text = read_file(&rp[0] as String, ref rlen);
    }
    var asmpath: [1024]u8;
    if asm_only { snprintf(&asmpath[0], 1024, "%s", outp as i64, 0, 0); }
    else { snprintf(&asmpath[0], 1024, "%s.s", outp as i64, 0, 0); }
    let o = fopen(&asmpath[0] as String, "w");
    if o == null { printf("aegisc: cannot write '%s'\n", &asmpath[0] as i64, 0, 0); return 1; }
    gen_program(o);
    fclose(o);
    if !asm_only {
        var cmd: [2200]u8;
        snprintf(&cmd[0], 2200, "gcc -no-pie -o '%s' '%s' -lm", outp as i64, &asmpath[0] as i64, 0);
        if system(&cmd[0] as String) != 0 { println("aegisc: assemble/link failed"); return 1; }
        remove(&asmpath[0] as String);
    }
    return 0;
}
