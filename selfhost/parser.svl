// AST dump driver: prints the same output as `svalinnc --dump-ast`.
module ParserDriver;
allow Console;
allow Native;
allow File.Read;

import std.io;
import std.mem;
import lex;
import err;
import types;
import ast;
import parse;
import dump;

unsafe fn main(argc: i32, argv: **u8) -> i32 {
    if argc < 2 { println("usage: parser <file.svl>"); return 1; }
    add_file_name(argv[1]);
    src_dir = dir_of(argv[1]);
    exe_dir = dir_of(argv[0]);
    var len: i32 = 0;
    let src = read_file(argv[1] as String, ref len);
    if src == null { println("cannot open file"); return 1; }
    types_init();
    var cnt: i32 = 0;
    toks = lex_to_array(src, len, 0, ref cnt);
    ntoks = cnt;
    ctoks = cnt + 1;
    load_prelude();
    load_main_args();
    expand_imports();
    prescan();
    parse_program();
    dump_typed = 0;
    dump_ast();
    return 0;
}
