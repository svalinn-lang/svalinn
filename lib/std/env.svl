// std.env - environment variables. Reading needs `allow Env.Read;`, changing needs `allow Env.Write;`
// (`allow Env;` grants both). The command line arrives in `fn main(args: Vec<String>)`.
module std.env;

import std.error;

extern fn getenv(name: String) -> *u8;
extern fn setenv(name: String, value: String, overwrite: i32) -> i32;
extern fn unsetenv(name: String) -> i32;

// Err(NotFound) when the variable is not set
fn env_var(name: String) -> Result<String, IOError> requires Env.Read {
    if name.len() == 0 { return Err(IOError.InvalidInput); }
    unsafe {
        let p = getenv(name);
        if p == null { return Err(IOError.NotFound); }
        return Ok(p as String);
    }
}

fn set_env_var(name: String, value: String) -> Result<void, IOError> requires Env.Write {
    if name.len() == 0 || name.contains("=") { return Err(IOError.InvalidInput); }
    unsafe { if setenv(name, value, 1) != 0 { return Err(last_io_error()); } }
    return Ok();
}

fn remove_env_var(name: String) -> Result<void, IOError> requires Env.Write {
    if name.len() == 0 || name.contains("=") { return Err(IOError.InvalidInput); }
    unsafe { if unsetenv(name) != 0 { return Err(last_io_error()); } }
    return Ok();
}
