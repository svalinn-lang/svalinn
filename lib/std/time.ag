// std.time - clocks and sleeping. No capability is needed.
module std.time;

extern fn clock_gettime(clock: i32, ts: *i64) -> i32;
extern fn nanosleep(req: *i64, rem: *i64) -> i32;

fn rt_clock(id: i32) -> i64 {
    var ts: [2]i64;
    unsafe { clock_gettime(id, &ts[0]); }
    return ts[0] * 1000000000 + ts[1];
}

// wall-clock time: milliseconds since 1970-01-01 UTC
fn now_ms() -> i64 { return rt_clock(0) / 1000000; }
// wall-clock time: seconds since 1970-01-01 UTC
fn now_secs() -> i64 { return rt_clock(0) / 1000000000; }
// a clock that never goes backwards, in nanoseconds (only differences are meaningful); use it to time code
fn monotonic_ns() -> i64 { return rt_clock(1); }

fn sleep_ms(ms: i64) {
    if ms <= 0 { return; }
    var ts: [2]i64;
    ts[0] = ms / 1000;
    ts[1] = (ms % 1000) * 1000000;
    unsafe { nanosleep(&ts[0], &ts[0]); }
}
